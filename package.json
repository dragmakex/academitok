{
  "name": "effect-tanstack-start",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/example.test.ts",
    "test:component": "vitest run src/component/*.test.tsx",
    "test:visual": "vitest run src/visual/*.test.tsx",
    "test:visual:update": "vitest run src/visual/*.test.tsx --update",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dprint:check": "dprint check",
    "dprint:format": "dprint fmt"
  },
  "dependencies": {
