# Application Environment Variables

# ==========================================
# Codefabrik / Codex Workflow (optional, only needed for workflow runs)
# ==========================================
CODEX_LB_API_KEY=
# Leave blank for local/dev unless you have a reachable Codex load balancer.
# In-cluster Kubernetes example: http://codex-lb.codex-lb.svc.cluster.local:2455
CODEX_LB_BASE_URL=
CODEX_MODEL=gpt-5.3-codex

# Node Environment ("development", "test", or "production")
NODE_ENV=development

# REQUIRED in production: identify metadata requests to OpenAlex's polite pool.
OPENALEX_MAILTO=

# ==========================================
# Sentry Configuration
# ==========================================
# Get your DSN from https://sentry.io or use self-hosted Sentry
SENTRY_DSN=
VITE_SENTRY_DSN=

# SENTRY_SECRET_KEY is managed by the LAOS stack.
# You do not need it in this app repo.

# ==========================================
# PostHog Configuration
# ==========================================
# For self-hosted PostHog (LAOS)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=http://localhost:8001

# For PostHog Cloud (uncomment if using cloud)
# VITE_POSTHOG_KEY=your-project-api-key
# VITE_POSTHOG_HOST=https://app.posthog.com

# Server-side PostHog (same as client for self-hosted)
POSTHOG_API_KEY=
POSTHOG_HOST=http://localhost:8001

# POSTHOG_SECRET_KEY is managed by the LAOS stack.
# You do not need it in this app repo.

# ==========================================
# Grafana Stack Configuration
# ==========================================
# Loki endpoint for logs
LOKI_ENDPOINT=http://localhost:3100/loki/api/v1/push

# OpenTelemetry endpoint for traces (Tempo, base URL, no path suffix)
OTLP_ENDPOINT=http://localhost:4318

# Loki OTLP endpoint for structured logs (base URL, no path suffix)
LOKI_OTLP_ENDPOINT=http://localhost:3100/otlp

# ==========================================
# Pyroscope (Continuous Profiling)
# ==========================================
PYROSCOPE_SERVER_ADDRESS=http://localhost:4040
SERVICE_NAME=effect-tanstack-start

# ==========================================
# Sign-in (email magic link) — REQUIRED in production
# ==========================================
# Resend API key. Leave blank in development: sign-in mail is logged instead of sent.
RESEND_API_KEY=
# Sender address, e.g. "AcademiTok <desk@academitok.example>".
MAIL_FROM=
# Comma-separated bare origins allowed to receive sign-in links (e.g. https://academitok.example).
# Blank allows any well-formed origin in development, but fails startup in production.
AUTH_ORIGINS=

# ==========================================
# Database — REQUIRED in production (PGlite fallback is disabled in production)
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/academitok
