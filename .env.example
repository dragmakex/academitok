# Application Environment Variables

# Node Environment
NODE_ENV=development

# ==========================================
# Sentry Configuration
# ==========================================
# Get your DSN from https://sentry.io or use self-hosted Sentry
SENTRY_DSN=

# Generate a random secret key for Sentry (minimum 32 characters)
# You can use: openssl rand -hex 32
SENTRY_SECRET_KEY=

# ==========================================
# PostHog Configuration
# ==========================================
# For self-hosted PostHog (default when using docker-compose)
VITE_POSTHOG_KEY=phc_development_key
VITE_POSTHOG_HOST=http://localhost:8001

# For PostHog Cloud (uncomment if using cloud)
# VITE_POSTHOG_KEY=your-project-api-key
# VITE_POSTHOG_HOST=https://app.posthog.com

# Server-side PostHog (same as client for self-hosted)
POSTHOG_API_KEY=phc_development_key
POSTHOG_HOST=http://posthog:8000

# PostHog secret key for self-hosted (minimum 32 characters)
POSTHOG_SECRET_KEY=

# ==========================================
# Grafana Stack Configuration
# ==========================================
# Loki endpoint for logs
LOKI_ENDPOINT=http://loki:3100/loki/api/v1/push

# OpenTelemetry endpoint for traces
OTLP_ENDPOINT=http://tempo:4318/v1/traces

# ==========================================
# Database (if needed for your app)
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
