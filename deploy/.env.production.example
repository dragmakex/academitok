# Copy to .env.production on the Ubuntu VPS and restrict permissions:
#   cp deploy/.env.production.example .env.production
#   chmod 600 .env.production
#
# Generate a strong database password with:
#   openssl rand -hex 24

# Public domain pointing (DNS A/AAAA) at this VPS — Caddy provisions Let's Encrypt TLS automatically
APP_DOMAIN=academitok.example.com

# PostgreSQL credentials (container-internal only; never exposed on public interfaces)
POSTGRES_USER=academitok
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=academitok

# OpenAlex polite-pool contact email
OPENALEX_MAILTO=desk@academitok.example.com

# Host directory where verified daily pg_dump backups + .sha256 checksums are written
HOST_BACKUP_DIR=/var/backups/academitok
BACKUP_INTERVAL_SECONDS=86400
RETENTION_DAYS=14

# Loopback port on the VPS for local health checks (Caddy handles public 80/443)
APP_BIND_PORT=3000

# Optional observability (leave blank to disable)
SERVICE_NAME=academitok
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
OTLP_ENDPOINT=
LOKI_OTLP_ENDPOINT=
POSTHOG_API_KEY=
POSTHOG_HOST=
