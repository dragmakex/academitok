[Unit]
Description=AcademiTok Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/academitok
ExecStart=/usr/bin/docker compose --env-file /opt/academitok/.env.production up -d
ExecStop=/usr/bin/docker compose --env-file /opt/academitok/.env.production down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
