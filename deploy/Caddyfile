# Automatic HTTPS reverse proxy for AcademiTok on an Ubuntu VPS.
# Set APP_DOMAIN in .env.production (e.g. academitok.example.com).

{$APP_DOMAIN} {
	encode zstd gzip

	# Bounded bodies: the largest legitimate payload is a batched impression flush.
	request_body {
		max_size 1048576
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# Reader-scoped responses must never sit in a shared cache.
	header / Cache-Control "private, no-store"
	header /saved Cache-Control "private, no-store"
	header /paper/* Cache-Control "private, no-store"
	header /api/* Cache-Control "private, no-store"

	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 15s
		health_timeout 5s
	}
}
