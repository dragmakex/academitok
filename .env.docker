# Docker Environment Variables
# This file contains default values for running the stack in Docker

# ==========================================
# Application
# ==========================================
NODE_ENV=development

# ==========================================
# Sentry (Self-Hosted)
# ==========================================
# Generate with: openssl rand -hex 32
SENTRY_SECRET_KEY=changeme-sentry-secret-key-min-32-chars!!

# After first run, get DSN from http://localhost:9000
SENTRY_DSN=

# ==========================================
# PostHog (Self-Hosted)
# ==========================================
# Client-side (browser)
VITE_POSTHOG_KEY=phc_development_key_change_in_production
VITE_POSTHOG_HOST=http://localhost:8001

# Server-side
POSTHOG_API_KEY=phc_development_key_change_in_production
POSTHOG_HOST=http://posthog:8000

# Generate with: openssl rand -hex 32 (minimum 32 characters)
POSTHOG_SECRET_KEY=changeme-posthog-secret-key-min-32-chars!!

# ==========================================
# Grafana Stack
# ==========================================
LOKI_ENDPOINT=http://loki:3100/loki/api/v1/push
OTLP_ENDPOINT=http://tempo:4318/v1/traces
